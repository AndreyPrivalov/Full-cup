{
  "name": "fullcup",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && node --watch index.js",
    "test": "node --test",
    "backup:export": "node scripts/backup_csv.js export",
    "backup:import": "node scripts/backup_csv.js import",
    "gsheets:push": "node scripts/sync_google_sheets.js push",
    "gsheets:pull": "node scripts/sync_google_sheets.js pull",
    "build": "npm --workspace=frontend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "start:backend": "cd backend && node index.js",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "concurrently": "^9.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "shared": "*",
    "zod": "^3.23.8"
  }
}
